# github oauth app used by the /admin docs editor
# the oauth app callback url must be <deployment-url>/api/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# optional overrides
# GITHUB_OAUTH_REDIRECT_URI=
# CMS_GITHUB_OWNER=ArbitrumFoundation
# CMS_GITHUB_REPO=docs
# CMS_BASE_BRANCH=main
# NEXT_PUBLIC_SITE_URL=https://docs.arbitrum.foundation

# local development only, lets /admin use a personal token instead of oauth
# CMS_DEV_GITHUB_TOKEN=
